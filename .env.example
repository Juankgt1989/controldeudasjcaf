# Copia este archivo como .env y rellena los valores.
# NUNCA subas el .env real a git: ya esta en .gitignore.

# Password de PostgreSQL. El compose lo lee desde aqui, asi que el valor
# NUNCA debe escribirse en docker-compose.prod.yml (quedaria en el git).
POSTGRES_PASSWORD="cambia-esta-password"

# Se arma sola a partir de POSTGRES_PASSWORD; no necesitas editarla.
DATABASE_URL="postgresql://postgres:cambia-esta-password@db:5432/debtcontrol?schema=public"

NEXTAUTH_URL="https://tu-dominio.com"

# Genera uno con:  openssl rand -base64 32
NEXTAUTH_SECRET="genera-un-secreto-largo-y-aleatorio"

# Telegram bot configuration (optional)
# Se obtiene con @BotFather. Si lo rotas, actualiza tambien el .env del servidor.
TELEGRAM_BOT_TOKEN=""

# Initial admin account
# Solo se usa la PRIMERA vez que se crea el usuario (prisma/seed.ts).
# Cambiarlo despues no modifica el password ya guardado en la base de datos.
ADMIN_EMAIL="admin@tu-dominio.com"
ADMIN_PASSWORD="una-contrasena-segura"
